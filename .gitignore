# Backend artifacts
backend/target/
backend/.mvn/
backend/*.log
backend/.flattened-pom.xml

# Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
